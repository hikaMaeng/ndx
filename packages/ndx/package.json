{
  "name": "@neurondev/ndx-core",
  "version": "0.1.41",
  "type": "module",
  "description": "Core ndx domain logic for CLI, server, dashboard, tools, models, and runtime.",
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/main.d.ts",
      "default": "./dist/cli/main.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard/index.d.ts",
      "default": "./dist/dashboard/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "yarn exec tsc -p tsconfig.json",
    "test": "node -e \"console.log('agenttest package policy: strict JSON results under test/YYYYMMDD')\""
  },
  "devDependencies": {
    "@types/node": "^20.19.18",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
