{
  "name": "ndx-monorepo",
  "private": true,
  "version": "0.1.40",
  "type": "module",
  "description": "TypeScript-first local coding agent monorepo.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "yarn turbo run build",
    "test": "node -e \"console.log('agenttest policy: strict JSON results under test/YYYYMMDD')\"",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.18",
    "prettier": "^3.5.3",
    "turbo": "^2.9.9",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22",
    "yarn": ">=4.14.1"
  },
  "packageManager": "yarn@4.14.1"
}
